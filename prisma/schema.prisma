generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AccountStatus {
  NotLogged
  Logged
  NotExist
  WrongPassword
  TwoFactorAuthFailed
  Blocked
  VerificationRequired
}

enum ProxyStatus {
  NotUsed
  Used
  Invalid
}

model Account {
  id                  String @id @default(uuid())
  username            String @unique
  password            String
  twoFactorAuthSecret String
  status              AccountStatus @default(NotLogged)

  proxyId             String?    @unique
  proxy               Proxy?     @relation(fields: [proxyId], references: [id], onDelete: Cascade)
}

model Proxy {
  id       String @id @default(uuid())
  proxyUrl String @unique
  status   ProxyStatus @default(NotUsed)

  account  Account?
}

model Campaign {
  id   String @id @default(uuid())
  name String @unique
  data Json // { unsername: string, id: string }[]
}